<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Single cross-platform project.
    - net8.0          : Windows + Linux, platform code is chosen at runtime (OperatingSystem.IsWindows()/IsLinux())
    - net8.0-windows  : same code plus WinForms/System.Drawing extras (SciterControl, Icon, Bitmap, ScreenCapture)
    macOS (OSX code paths, Xamarin.Mac) is not wired yet: those branches are kept behind #if OSX and are compiled out.
  -->
  <PropertyGroup>
    <TargetFrameworks>net8.0;net8.0-windows</TargetFrameworks>
    <AssemblyName>SciterSharpJS</AssemblyName>
    <RootNamespace>SciterSharp</RootNamespace>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>SciterMidi.snk</AssemblyOriginatorKeyFile>
    <DelaySign>false</DelaySign>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <DefineConstants>$(DefineConstants);SCITER_JS_NEW</DefineConstants>

    <!-- NuGet package -->
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageId>SciterSharpJS</PackageId>
    <!-- single source of truth: LibVersion.AssemblyVersion -->
    <Version>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)LibVersion.cs')), 'AssemblyVersion\s*=\s*"([^"]+)"').Groups[1].Value)</Version>
    <Authors>Ramon F. Mendes</Authors>
    <Company>MI Software</Company>
    <Description>C# bindings for the Sciter.JS engine (Windows and Linux)</Description>
    <Copyright>Copyright MI Software 2018</Copyright>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/ramon-mendes/SciterSharp</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ramon-mendes/SciterSharp</RepositoryUrl>
    <PackageTags>Sciter HTML C#</PackageTags>
    <PackageIcon>sciter-sharp.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)'=='net8.0-windows'">
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)'!='net8.0-windows'">
    <Compile Remove="WinForms\**" />
  </ItemGroup>

  <!-- CopyToOutputDirectory: ProjectReference consumers get runtimes/<rid>/native too (SciterX resolves it at runtime) -->
  <ItemGroup>
    <None Include="runtimes\linux-arm64\native\libsciter.so" Pack="true" PackagePath="runtimes/linux-arm64/native/" CopyToOutputDirectory="PreserveNewest" />
    <None Include="runtimes\linux-x64\native\libsciter.so" Pack="true" PackagePath="runtimes/linux-x64/native/" CopyToOutputDirectory="PreserveNewest" />
    <None Include="runtimes\win-x64\native\sciter.dll" Pack="true" PackagePath="runtimes/win-x64/native/" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\sciter-sharp.png" Pack="true" PackagePath="\" Visible="false" />
    <None Include="..\README.md" Pack="true" PackagePath="\" Visible="false" />
    <None Include="runtimes\win-x86\native\sciter.dll" Pack="true" PackagePath="runtimes/win-x86/native/" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.298">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
